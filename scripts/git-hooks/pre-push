#!/bin/bash
# Guardrail (last line before the PUBLIC remote): scan every commit being pushed.
# git feeds "<local ref> <local sha> <remote ref> <remote sha>" lines on stdin.
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
Z="0000000000000000000000000000000000000000"
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$Z" ] && continue                  # branch deletion
  if [ "$remote_sha" = "$Z" ]; then
    # New branch: scan only what is NOT already on the remote's main (a whole-tree scan
    # re-flagged the placeholder in _keys.py.example on 2026-09-05 and blocked a clean
    # write-up). Fall back to the whole tree only if origin/main is unknown.
    if git rev-parse --verify -q origin/main >/dev/null; then
      base="$(git merge-base origin/main "$local_sha")"
      src=(git diff "$base..$local_sha")
      export STAGED_FILES="$(git diff --name-only "$base..$local_sha" 2>/dev/null)"
    else
      src=(git diff "$(git hash-object -t tree /dev/null)".."$local_sha")
      export STAGED_FILES="$(git ls-tree -r --name-only "$local_sha" 2>/dev/null)"
    fi
  else
    src=(git diff "$remote_sha..$local_sha")           # scan only new commits
    export STAGED_FILES="$(git diff --name-only ${remote_sha}..${local_sha} 2>/dev/null)"
  fi
  "$DIR/_scan.sh" "${src[@]}" || status=1
done
[ "$status" -ne 0 ] && echo "Push blocked by secret-scan guardrail." && exit 1
exit 0
